[
  {
    "id": "salesforce:oauth-token",
    "note": "OAuth 2.0 token endpoint. Returns instance_url, which n8n's Salesforce credential uses as the base for every later call.",
    "match": {
      "method": "POST",
      "path": "/services/oauth2/token"
    },
    "respond": {
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "access_token": "00Dmock00!MOCKSESSIONTOKEN",
        "instance_url": "https://integration-mock-dev.my.salesforce.com",
        "id": "https://login.salesforce.com/id/00Dmock00000000EAA/005mock00000000AAA",
        "token_type": "Bearer",
        "issued_at": "1700000000000",
        "signature": "integration-mock-signature"
      }
    }
  },
  {
    "id": "salesforce:query-malformed",
    "note": "SOQL error shape: a JSON array of {message, errorCode}. Listed before the general query route so the specific q= match wins.",
    "match": {
      "method": "GET",
      "path": "/services/data/:version/query",
      "query": {
        "q": "INVALID"
      }
    },
    "respond": {
      "status": 400,
      "headers": {
        "content-type": "application/json"
      },
      "body": [
        {
          "message": "unexpected token: INVALID",
          "errorCode": "MALFORMED_QUERY"
        }
      ]
    }
  },
  {
    "id": "salesforce:opportunity-describe",
    "note": "Literal segment, so it must precede the :id route or the id pattern captures the word 'describe'.",
    "match": {
      "method": "GET",
      "path": "/services/data/:version/sobjects/Opportunity/describe"
    },
    "respond": {
      "status": 200,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "name": "Opportunity",
        "label": "Opportunity",
        "createable": true,
        "updateable": true,
        "fields": [
          {
            "name": "Id",
            "type": "id",
            "label": "Opportunity ID"
          },
          {
            "name": "Name",
            "type": "string",
            "label": "Opportunity Name"
          },
          {
            "name": "StageName",
            "type": "picklist",
            "label": "Stage"
          },
          {
            "name": "Amount",
            "type": "currency",
            "label": "Amount"
          },
          {
            "name": "CloseDate",
            "type": "date",
            "label": "Close Date"
          }
        ]
      }
    }
  },
  {
    "id": "salesforce:opportunity-not-found",
    "note": "Sentinel id for exercising 404 handling. Literal, so listed before the :id route.",
    "match": {
      "method": "GET",
      "path": "/services/data/:version/sobjects/Opportunity/006mock00MISSING"
    },
    "respond": {
      "status": 404,
      "headers": {
        "content-type": "application/json"
      },
      "body": [
        {
          "message": "Provided external ID field does not exist or is not accessible: 006mock00MISSING",
          "errorCode": "NOT_FOUND"
        }
      ]
    }
  },
  {
    "id": "salesforce:query",
    "note": "SOQL query against the store. FROM picks the sObject; WHERE (AND only), ORDER BY, LIMIT and SELECT trimming are honoured; anything else is a 400. Pages of 2000 follow nextRecordsUrl.",
    "match": {
      "method": "GET",
      "path": "/services/data/:version/query"
    },
    "store": {
      "op": "list",
      "filters": [
        {
          "from": "query.q",
          "style": "soql"
        }
      ],
      "pagination": {
        "style": "nextUrl",
        "defaultLimit": 2000,
        "maxLimit": 2000,
        "nextUrlTemplate": "/services/data/{{request.params.version}}/query/{{token}}"
      },
      "badRequest": {
        "status": 400,
        "template": true,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "message": "{{error}}",
            "errorCode": "MALFORMED_QUERY"
          }
        ]
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "totalSize": "{{page.total}}",
        "done": "{{page.done}}",
        "records": "{{records}}",
        "nextRecordsUrl": "{{page.nextUrl}}"
      }
    }
  },
  {
    "id": "salesforce:query-more",
    "note": "The nextRecordsUrl of a query: the next page of the same result.",
    "match": {
      "method": "GET",
      "path": "/services/data/:version/query/:token"
    },
    "store": {
      "op": "list",
      "pagination": {
        "style": "nextUrl",
        "tokenParam": "token",
        "nextUrlTemplate": "/services/data/{{request.params.version}}/query/{{token}}"
      },
      "badRequest": {
        "status": 400,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "message": "invalid query locator",
            "errorCode": "INVALID_QUERY_LOCATOR"
          }
        ]
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "totalSize": "{{page.total}}",
        "done": "{{page.done}}",
        "records": "{{records}}",
        "nextRecordsUrl": "{{page.nextUrl}}"
      }
    }
  },
  {
    "id": "salesforce:opportunity-create",
    "note": "Create returns {id, success, errors} with 201, not the record.",
    "match": {
      "method": "POST",
      "path": "/services/data/:version/sobjects/Opportunity"
    },
    "store": {
      "op": "create",
      "collection": "Opportunity",
      "id": {
        "field": "Id",
        "format": "006MOCK{{seq:11}}"
      },
      "stamp": {
        "attributes": {
          "type": "Opportunity",
          "url": "/services/data/{{request.params.version}}/sobjects/Opportunity/{{record.Id}}"
        }
      }
    },
    "respond": {
      "status": 201,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "id": "{{record.Id}}",
        "success": true,
        "errors": []
      }
    }
  },
  {
    "id": "salesforce:opportunity-get",
    "match": {
      "method": "GET",
      "path": "/services/data/:version/sobjects/Opportunity/:id"
    },
    "store": {
      "op": "get",
      "collection": "Opportunity",
      "idParam": "id",
      "notFound": {
        "status": 404,
        "headers": {
          "content-type": "application/json"
        },
        "body": [
          {
            "errorCode": "NOT_FOUND",
            "message": "The requested resource does not exist"
          }
        ]
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{{record}}"
    }
  },
