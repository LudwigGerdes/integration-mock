  {
    "id": "stripe:customers-create",
    "match": {
      "method": "POST",
      "path": "/v1/customers"
    },
    "store": {
      "op": "create",
      "collection": "customers",
      "id": {
        "field": "id",
        "format": "cus_MOCK{{seq:6}}"
      },
      "stamp": {
        "object": "customer",
        "created": "{{timestamp}}",
        "livemode": false
      },
      "idempotency": {
        "header": "Idempotency-Key"
      },
      "conflict": {
        "status": 409,
        "headers": {
          "content-type": "application/json"
        },
        "body": {
          "error": {
            "type": "idempotency_error",
            "message": "Keys for idempotent requests can only be used with the same parameters they were first used with."
          }
        }
      },
      "coerce": {
        "balance": "number"
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{{record}}"
    }
  },
  {
    "id": "stripe:customers-list",
    "match": {
      "method": "GET",
      "path": "/v1/customers"
    },
    "store": {
      "op": "list",
      "collection": "customers",
      "filters": [
        {
          "from": "query.email",
          "field": "email"
        },
        {
          "from": "query.created[gte]",
          "field": "created",
          "op": "gte"
        },
        {
          "from": "query.created[gt]",
          "field": "created",
          "op": "gt"
        },
        {
          "from": "query.created[lte]",
          "field": "created",
          "op": "lte"
        },
        {
          "from": "query.created[lt]",
          "field": "created",
          "op": "lt"
        }
      ],
      "pagination": {
        "style": "cursor",
        "cursorParam": "starting_after",
        "limitParam": "limit",
        "defaultLimit": 10,
        "maxLimit": 100
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "object": "list",
        "url": "/v1/customers",
        "has_more": "{{page.hasMore}}",
        "data": "{{records}}"
      }
    }
  },
  {
    "id": "stripe:customers-get",
    "match": {
      "method": "GET",
      "path": "/v1/customers/:customer"
    },
    "store": {
      "op": "get",
      "collection": "customers",
      "notFound": {
        "status": 404,
        "headers": {
          "content-type": "application/json"
        },
        "template": true,
        "body": {
          "error": {
            "type": "invalid_request_error",
            "code": "resource_missing",
            "param": "id",
            "message": "No such customer: '{{request.params.customer}}'"
          }
        }
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": "{{record}}"
    }
  },
