{
  "id": "gmail",
  "domains": [
    "gmail.googleapis.com"
  ],
  "prefix": "/gmail",
  "source": "openapi",
  "scenarios": {
    "revoked": {
      "status": 401,
      "body": {
        "error": {
          "errors": [
            {
              "domain": "global",
              "reason": "authError",
              "message": "Invalid Credentials",
              "locationType": "header",
              "location": "Authorization"
            }
          ],
          "code": 401,
          "message": "Invalid Credentials"
        }
      },
      "note": "https://developers.google.com/workspace/gmail/api/guides/handle-errors: the documented 401 body"
    },
    "forbidden": {
      "status": 403,
      "body": {
        "error": {
          "errors": [
            {
              "domain": "global",
              "reason": "domainPolicy",
              "message": "The domain administrators have disabled Gmail apps."
            }
          ],
          "code": 403,
          "message": "The domain administrators have disabled Gmail apps."
        }
      },
      "note": "https://developers.google.com/workspace/gmail/api/guides/handle-errors: the documented 403 domainPolicy body, the permission refusal that page shows"
    },
    "rateLimit": {
      "status": 403,
      "body": {
        "error": {
          "errors": [
            {
              "domain": "usageLimits",
              "reason": "rateLimitExceeded",
              "message": "Rate Limit Exceeded"
            }
          ],
          "code": 403,
          "message": "Rate Limit Exceeded"
        }
      },
      "note": "https://developers.google.com/workspace/gmail/api/guides/handle-errors: the documented 403 rateLimitExceeded body (Gmail also answers 429 for sending, bandwidth and concurrency limits, without a documented body)"
    }
  }
}
