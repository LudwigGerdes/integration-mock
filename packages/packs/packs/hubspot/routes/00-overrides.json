  {
    "id": "hubspot:contacts-search",
    "note": "Search: filterGroups (OR of AND groups), after/limit in the body.",
    "match": {
      "method": "POST",
      "path": "/crm/v3/objects/contacts/search"
    },
    "store": {
      "op": "list",
      "collection": "contacts",
      "filters": [
        {
          "from": "body.filterGroups",
          "style": "hubspot"
        },
        {
          "from": "body.query",
          "style": "unsupported"
        },
        {
          "from": "body.sorts",
          "style": "unsupported"
        }
      ],
      "pagination": {
        "style": "cursor",
        "in": "body",
        "cursorParam": "after",
        "limitParam": "limit",
        "defaultLimit": 10,
        "maxLimit": 200
      }
    },
    "respond": {
      "status": 200,
      "template": true,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "total": "{{page.total}}",
        "results": "{{records}}",
        "paging": {
          "next": {
            "after": "{{page.next}}"
          }
        }
      }
    }
  },
