{
	"name": "integration-mock-proxy",
	"version": "0.1.0",
	"private": true,
	"description": "integration-mock internals: the mock daemon — CA, TLS termination, MockEngine, base-URL serving, admin API (bundled into the integration-mock CLI; not published)",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./daemon": {
			"types": "./dist/daemon.d.ts",
			"import": "./dist/daemon.js",
			"default": "./dist/daemon.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"integration-mock-core": "workspace:*",
		"node-forge": "^1.3.1",
		"undici": "^6.19.0",
		"integration-mock-packs": "workspace:*"
	},
	"devDependencies": {
		"@types/node-forge": "^1.3.11"
	},
	"files": [
		"dist"
	]
}
